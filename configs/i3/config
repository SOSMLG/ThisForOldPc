# i3 config - adapted from DebianSway (X11, distro-agnostic)
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu dmenu_run
set $file thunar
set $browser firefox

font pango:JetBrainsMono Nerd Font 10

# Graphite-Amber colors
set $base   #16181D
set $mantle #202329
set $crust  #16181D
set $text   #D8D3C8
set $subtext #9A9AA2
set $accent #E8A33D
set $surface #30343B
set $red     #E8A33D

client.focused          $accent $mantle $text $accent $accent
client.focused_inactive $surface $mantle $subtext $surface $surface
client.unfocused        $surface $crust $subtext $surface $surface
client.urgent           $red $crust $text $red $red

gaps inner 5
gaps outer 0
default_border pixel 3

# Autostart
exec --no-startup-id i3status
exec --no-startup-id picom -b 2>/dev/null || true
exec --no-startup-id nm-applet 2>/dev/null || true
exec --no-startup-id feh --bg-fill ~/.config/i3/wallpaper.png 2>/dev/null || true

# Keybindings
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+t exec $file
bindsym $mod+z exec $browser
bindsym $mod+m fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

# Resize mode
mode "resize" {
  bindsym $left resize shrink width 10 px or 10 ppt
  bindsym $down resize grow height 10 px or 10 ppt
  bindsym $up resize shrink height 10 px or 10 ppt
  bindsym $right resize grow width 10 px or 10 ppt
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Bar
bar {
  status_command i3status
  colors {
    background $base
    statusline $text
    focused_workspace $accent $accent $base
    inactive_workspace $surface $surface $subtext
  }
}
